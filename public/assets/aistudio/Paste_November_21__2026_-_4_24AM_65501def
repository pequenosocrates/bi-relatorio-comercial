<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BI · Relatório Comercial Diário</title>
    <meta name="theme-color" content="#192863">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- SheetJS (xlsx) para exportação real de Excel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <!-- Configuração Tailwind com Identidade Oficial Bilil (Grupo CTS) -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            950: '#101B47', // Azul-marinho profundo
                            900: '#192863', // Azul-marinho oficial Bilil (Cabeçalhos e títulos)
                            800: '#223682', // Azul-marinho hover
                            700: '#2F469C',
                            cyan: '#0084C7', // Azul-ciano oficial (Ícones, linhas e destaques)
                            cyanLight: '#E0F2FE',
                            gold: '#F59E0B', // Âmbar/Dourado oficial (Botões de acção principais)
                            goldHover: '#D97706',
                            surface: '#F4F8FB', // Fundo claro suave dos cartões
                            accent: '#0084C7',
                            accentHover: '#0369A1',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Ajustes globais mobile-first */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F4F8FB;
            color: #192863;
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior-y: contain;
        }

        /* Estilo suave para scrollbar horizontal nos passos */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Campos bloqueados */
        input:disabled, textarea:disabled, select:disabled {
            background-color: #EEF4F8 !important;
            color: #475569 !important;
            border-color: #CBD5E1 !important;
            cursor: not-allowed;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-brand-surface text-slate-800 select-none sm:select-auto">

    <!-- ==================== MODAL / CAIXA DE MENSAGEM CUSTOMIZADA (Substitui alert/confirm) ==================== -->
    <div id="custom-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-brand-950/70 backdrop-blur-sm p-4 transition-opacity">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 border border-sky-100 transform transition-all">
            <div class="flex items-center gap-3 mb-3">
                <div id="modal-icon-container" class="w-10 h-10 rounded-full flex items-center justify-center bg-sky-100 text-brand-cyan shrink-0">
                    <i id="modal-icon" class="fa-solid fa-circle-info text-lg"></i>
                </div>
                <h3 id="modal-title" class="text-lg font-bold text-brand-900 leading-tight">Atenção</h3>
            </div>
            <p id="modal-message" class="text-slate-600 text-sm leading-relaxed mb-6">Mensagem</p>
            <div id="modal-actions" class="flex flex-col sm:flex-row gap-2.5 justify-end">
                <button id="modal-cancel-btn" class="w-full sm:w-auto px-4 py-3 rounded-xl font-semibold text-sm text-slate-700 bg-slate-100 hover:bg-slate-200 active:scale-[0.99] transition">
                    Cancelar
                </button>
                <button id="modal-confirm-btn" class="w-full sm:w-auto px-5 py-3 rounded-xl font-bold text-sm text-brand-950 bg-brand-gold hover:bg-brand-goldHover active:scale-[0.99] transition shadow-sm">
                    Confirmar
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== TOAST NOTIFICATION ==================== -->
    <div id="toast-container" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-40 pointer-events-none flex flex-col gap-2 w-11/12 max-w-sm"></div>

    <!-- ==================== ECRÃ 1: AUTENTICAÇÃO (IDENTIDADE BILIL) ==================== -->
    <div id="auth-screen" class="min-h-screen flex flex-col justify-center items-center p-5 bg-gradient-to-br from-brand-950 via-brand-900 to-brand-800">
        <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-white/20 p-7 sm:p-9">
            <!-- Logótipo Oficial Bilil -->
            <!-- Logótipo Oficial BI -->
            <div class="flex items-center gap-3.5 mb-6">
                <div class="w-16 h-14 rounded-2xl bg-brand-surface border border-sky-200/80 flex items-center justify-center shadow-sm shrink-0 px-2">
                    <svg viewBox="0 0 110 64" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Barras de BI ascendentes -->
                        <rect x="58" y="34" width="6" height="16" rx="2" fill="#7DD3FC"/>
                        <rect x="67" y="26" width="6" height="24" rx="2" fill="#38BDF8"/>
                        <rect x="76" y="18" width="6" height="32" rx="2" fill="#0284C7"/>
                        <rect x="85" y="10" width="6" height="40" rx="2" fill="#192863"/>
                        <!-- Seta de crescimento -->
                        <path d="M56 28L70 17L79 21L91 8" stroke="#0084C7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M85 8H91V14" stroke="#0084C7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <!-- Tipografia BI -->
                        <text x="12" y="45" font-family="Inter, sans-serif" font-weight="800" font-size="34" fill="#192863">BI</text>
                    </svg>
                </div>
                <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full bg-sky-100 text-brand-cyan text-[10px] font-extrabold uppercase tracking-wider mb-1">
                        Business Intelligence · CTS
                    </span>
                    <h1 class="text-xl font-extrabold text-brand-900 tracking-tight leading-tight">Relatório Comercial Diário</h1>
                </div>
            </div>
            
            <p id="auth-subtitle" class="text-slate-500 text-sm mb-6 leading-relaxed">Plataforma móvel de registo comercial no terreno. Introduza o seu código de acesso pessoal.</p>

            <!-- Formulário de Login (Quando já existe código criado) -->
            <form id="login-form" class="space-y-5" novalidate>
                <div>
                    <label for="access-code-input" class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-2">
                        Código de Acesso (5 caracteres)
                    </label>
                    <div class="relative">
                        <input 
                            type="password" 
                            id="access-code-input" 
                            maxlength="5" 
                            autocomplete="off"
                            placeholder="Ex: •••••"
                            class="w-full text-center tracking-[0.4em] text-2xl font-bold uppercase px-4 py-4 rounded-2xl border-2 border-slate-200 focus:border-brand-cyan focus:outline-none transition bg-brand-surface focus:bg-white text-brand-900"
                        >
                        <button type="button" id="toggle-code-visibility" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-brand-900 p-2" aria-label="Mostrar código">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <p id="auth-error-msg" class="text-red-600 text-xs font-medium mt-2 hidden flex items-center gap-1.5">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>Formato inválido. Utilize exactamente 2 letras maiúsculas e 3 números (ex: AB123).</span>
                    </p>
                </div>

                <button type="submit" class="w-full py-4 px-6 rounded-full bg-brand-gold hover:bg-brand-goldHover text-brand-950 font-extrabold text-base shadow-lg shadow-amber-500/25 active:scale-[0.99] transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>Aceder à Plataforma</span>
                </button>
            </form>

            <!-- Formulário de Criação Inicial de Palavra-Passe / Código (Primeiro Acesso) -->
            <form id="setup-code-form" class="hidden space-y-4" novalidate>
                <div class="p-3.5 rounded-2xl bg-sky-50 border-l-4 border-brand-cyan text-xs text-brand-900 leading-relaxed">
                    <strong>Primeiro acesso:</strong> Crie a sua palavra-passe pessoal com exactamente <strong>2 letras maiúsculas e 3 números</strong> (ex: <code class="font-bold text-brand-cyan">AB123</code>).
                </div>

                <div>
                    <label for="new-code-input" class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5">
                        Criar Palavra-Passe (5 caracteres)
                    </label>
                    <input 
                        type="password" 
                        id="new-code-input" 
                        maxlength="5" 
                        autocomplete="off"
                        placeholder="Ex: AB123"
                        class="w-full text-center tracking-[0.4em] text-xl font-bold uppercase px-4 py-3.5 rounded-2xl border-2 border-slate-200 focus:border-brand-cyan focus:outline-none transition bg-brand-surface focus:bg-white text-brand-900"
                    >
                </div>

                <div>
                    <label for="confirm-code-input" class="block text-xs font-bold uppercase tracking-wider text-brand-900 mb-1.5">
                        Confirmar Palavra-Passe
                    </label>
                    <input 
                        type="password" 
                        id="confirm-code-input" 
                        maxlength="5" 
                        autocomplete="off"
                        placeholder="Repita o código"
                        class="w-full text-center tracking-[0.4em] text-xl font-bold uppercase px-4 py-3.5 rounded-2xl border-2 border-slate-200 focus:border-brand-cyan focus:outline-none transition bg-brand-surface focus:bg-white text-brand-900"
                    >
                </div>

                <p id="setup-error-msg" class="text-red-600 text-xs font-medium hidden flex items-center gap-1.5">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>Erro de validação.</span>
                </p>

                <button type="submit" class="w-full py-4 px-6 rounded-full bg-brand-gold hover:bg-brand-goldHover text-brand-950 font-extrabold text-base shadow-lg shadow-amber-500/25 active:scale-[0.99] transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-key"></i>
                    <span>Guardar Palavra-Passe e Entrar</span>
                </button>
            </form>

            <div class="mt-7 pt-5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                <span class="flex items-center gap-1.5 font-medium text-brand-900/70"><i class="fa-solid fa-shield-halved text-emerald-600"></i> Grupo CTS · Maputo</span>
                <span class="text-brand-cyan font-semibold">Modo Offline Activo</span>
            </div>
        </div>
    </div>

    <!-- ==================== APLICAÇÃO PRINCIPAL (APÓS AUTENTICAÇÃO) ==================== -->
    <div id="app-shell" class="hidden min-h-screen flex-col">
        
        <!-- BARRA SUPERIOR FIXA (AZUL-MARINHO OFICIAL BILIL) -->
        <header class="sticky top-0 z-30 bg-brand-900 text-white shadow-md border-b border-white/10">
            <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
                <button onclick="navigateTo('dashboard')" class="flex items-center gap-3 text-left focus:outline-none">
                    <!-- Emblema Branco Arredondado BI -->
                    <div class="w-11 h-9 rounded-xl bg-white flex items-center justify-center shadow-sm px-1.5 shrink-0">
                        <svg viewBox="0 0 110 64" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="58" y="34" width="6" height="16" rx="2" fill="#7DD3FC"/>
                            <rect x="67" y="26" width="6" height="24" rx="2" fill="#38BDF8"/>
                            <rect x="76" y="18" width="6" height="32" rx="2" fill="#0284C7"/>
                            <rect x="85" y="10" width="6" height="40" rx="2" fill="#192863"/>
                            <path d="M56 28L70 17L79 21L91 8" stroke="#0084C7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                            <text x="12" y="46" font-family="Inter, sans-serif" font-weight="800" font-size="35" fill="#192863">BI</text>
                        </svg>
                    </div>
                    <div>
                        <h1 class="font-bold text-sm sm:text-base leading-tight text-white">Relatório Comercial Diário</h1>
                        <p id="header-date-display" class="text-xs text-sky-300 font-medium">--/--/----</p>
                    </div>
                </button>

                <div class="flex items-center gap-1.5 sm:gap-2">
                    <button onclick="navigateTo('settings')" class="p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-sky-100 transition" title="Definições e Vendedor">
                        <i class="fa-solid fa-gear text-base"></i>
                    </button>
                    <button onclick="handleLogout()" class="p-2.5 rounded-xl bg-red-500/20 hover:bg-red-500/30 text-red-200 transition" title="Terminar Sessão">
                        <i class="fa-solid fa-power-off text-base"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- CONTEÚDO DINÂMICO -->
        <main class="flex-1 max-w-3xl w-full mx-auto px-4 py-5 pb-24">

            <!-- ==================== VISTA 1: PAINEL PRINCIPAL (DASHBOARD) ==================== -->
            <section id="view-dashboard" class="space-y-5">
                
                <!-- Cartão de Identificação e Progresso -->
                <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-sky-100 border-l-4 border-l-brand-cyan">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
                        <div>
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-brand-cyan">Vendedor Responsável</span>
                            <div class="flex items-center gap-2 mt-0.5">
                                <h2 id="dash-seller-name" class="text-lg font-extrabold text-brand-900">Não definido</h2>
                                <button onclick="navigateTo('settings')" class="text-xs font-bold text-brand-cyan hover:underline px-2.5 py-1 rounded-lg bg-sky-50">
                                    Editar
                                </button>
                            </div>
                        </div>
                        <div class="bg-brand-surface px-4 py-2.5 rounded-2xl border border-sky-100 flex items-center justify-between sm:justify-end gap-4">
                            <div>
                                <span class="block text-[11px] font-bold uppercase text-slate-400">Progresso Diário</span>
                                <span id="dash-progress-text" class="text-xl font-extrabold text-brand-900">Visitas 00/10</span>
                            </div>
                            <div class="w-11 h-11 rounded-full bg-sky-100 text-brand-cyan flex items-center justify-center font-extrabold text-sm" id="dash-progress-percent">
                                0%
                            </div>
                        </div>
                    </div>

                    <!-- Barra de Progresso Visual -->
                    <div class="mt-4">
                        <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden">
                            <div id="dash-progress-bar" class="h-full bg-gradient-to-r from-brand-900 to-brand-cyan transition-all duration-500 rounded-full" style="width: 0%"></div>
                        </div>
                        <div class="flex justify-between text-xs text-slate-500 mt-2 font-semibold">
                            <span id="dash-locked-count" class="text-emerald-700">0 Concluídas/Bloqueadas</span>
                            <span id="dash-draft-count" class="text-brand-cyan">0 Em curso</span>
                        </div>
                    </div>

                    <!-- Botão Principal: Continuar Relatório (Destaque Dourado/Âmbar Oficial) -->
                    <div class="mt-6">
                        <button onclick="continueReport()" class="w-full py-4 px-5 rounded-full bg-brand-gold hover:bg-brand-goldHover text-brand-950 font-extrabold text-base shadow-md shadow-amber-500/20 active:scale-[0.99] transition flex items-center justify-center gap-3">
                            <i class="fa-solid fa-play text-brand-900"></i>
                            <span id="dash-continue-label">Continuar Relatório (Visita 01)</span>
                        </button>
                    </div>
                </div>

                <!-- Grelha de 10 Visitas Independentes -->
                <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-sky-100">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-extrabold text-brand-900 text-base">Registos das 10 Visitas</h3>
                        <span class="text-xs text-brand-cyan font-semibold">Toque para abrir</span>
                    </div>

                    <div id="visits-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Preenchido dinamicamente via JS -->
                    </div>
                </div>

                <!-- Acções de Fecho, Resumo e Exportação -->
                <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-sky-100 space-y-3">
                    <h3 class="font-extrabold text-brand-900 text-base mb-1">Fecho e Envio do Relatório</h3>
                    
                    <button onclick="navigateTo('summary')" class="w-full py-3.5 px-4 rounded-2xl bg-brand-surface hover:bg-sky-100/70 text-brand-900 border border-sky-200/70 font-bold text-sm transition flex items-center justify-center gap-2.5">
                        <i class="fa-solid fa-clipboard-list text-brand-cyan text-base"></i>
                        <span>Visualizar Resumo Diário</span>
                    </button>

                    <button onclick="prepareWhatsAppShare()" class="w-full py-4 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-sm active:scale-[0.99] transition flex items-center justify-center gap-2.5">
                        <i class="fa-brands fa-whatsapp text-xl"></i>
                        <span>Enviar Relatório pelo WhatsApp</span>
                    </button>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                        <button onclick="exportToExcel(false)" class="w-full py-3.5 px-4 rounded-2xl border-2 border-slate-200 hover:border-brand-900/30 bg-white text-brand-900 font-bold text-sm transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-file-excel text-emerald-600 text-base"></i>
                            <span>Descarregar Excel</span>
                        </button>
                        <button onclick="exportToExcel(true)" class="w-full py-3.5 px-4 rounded-2xl border-2 border-sky-200 hover:border-brand-cyan bg-sky-50/70 text-brand-900 font-bold text-sm transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-share-nodes text-brand-cyan text-base"></i>
                            <span>Exportar Excel e Partilhar</span>
                        </button>
                    </div>
                </div>

            </section>

            <!-- ==================== VISTA 2: FORMULÁRIO INDIVIDUAL DE VISITA (01 a 10) ==================== -->
            <section id="view-visit" class="hidden space-y-4">
                
                <!-- Navegação rápida horizontal entre visitas -->
                <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1" id="visit-step-pills">
                    <!-- Pills 01 a 10 -->
                </div>

                <!-- Cabeçalho da Visita Actual -->
                <div class="bg-white rounded-3xl p-5 shadow-sm border border-sky-100 border-l-4 border-l-brand-900">
                    <div class="flex items-center justify-between gap-2 mb-3">
                        <div>
                            <span class="text-[11px] font-extrabold uppercase tracking-widest text-brand-cyan">RELATÓRIO COMERCIAL · BI</span>
                            <h2 id="visit-header-title" class="text-xl font-extrabold text-brand-900">Visita 01 de 10</h2>
                        </div>
                        <div id="visit-status-badge" class="px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 bg-amber-100 text-amber-800">
                            <i class="fa-solid fa-pen"></i>
                            <span>Em preenchimento</span>
                        </div>
                    </div>

                    <!-- Barra de progresso da visita na sequência -->
                    <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                        <div id="visit-step-bar" class="h-full bg-gradient-to-r from-brand-900 to-brand-cyan transition-all duration-300" style="width: 10%"></div>
                    </div>

                    <!-- Banner de Protecção quando a visita está TRANCADA -->
                    <div id="locked-banner" class="hidden mt-4 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-lock text-base"></i>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-emerald-950">Visita concluída e protegida</p>
                                <p class="text-xs text-emerald-700">Os campos estão bloqueados contra alterações acidentais.</p>
                            </div>
                        </div>
                        <button type="button" onclick="requestUnlockVisit()" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-white border border-emerald-300 hover:bg-emerald-100 text-emerald-900 font-bold text-xs shadow-sm transition flex items-center justify-center gap-1.5 shrink-0">
                            <i class="fa-solid fa-lock-open"></i>
                            <span>Destrancar para editar</span>
                        </button>
                    </div>
                </div>

                <!-- Formulário da Empresa -->
                <form id="visit-form" class="bg-white rounded-3xl p-5 sm:p-6 shadow-sm border border-sky-100 space-y-5" onsubmit="return false;">
                    
                    <!-- 01. Empresa -->
                    <div>
                        <label for="field-company" class="block text-sm font-bold text-brand-900 mb-1.5">
                            01. Empresa <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="field-company" placeholder="Nome da empresa ou cliente visitado" 
                            class="w-full px-4 py-3.5 rounded-2xl border border-slate-300 focus:border-brand-cyan focus:ring-2 focus:ring-sky-500/20 focus:outline-none text-base transition">
                    </div>

                    <!-- 02. Descrição -->
                    <div>
                        <label for="field-description" class="block text-sm font-bold text-brand-900 mb-1.5">
                            02. Descrição <span class="text-red-500">*</span>
                        </label>
                        <textarea id="field-description" rows="3" placeholder="Descreva brevemente a actividade da empresa, contexto da visita ou o que foi observado..." 
                            class="w-full px-4 py-3 rounded-2xl border border-slate-300 focus:border-brand-cyan focus:ring-2 focus:ring-sky-500/20 focus:outline-none text-base transition"></textarea>
                    </div>

                    <!-- 03. Location (Localização) -->
                    <div>
                        <label for="field-location" class="block text-sm font-bold text-brand-900 mb-1.5">
                            03. Location (Localização)
                        </label>
                        <div class="space-y-2.5">
                            <input type="url" id="field-location" placeholder="Cole o link do Google Maps ou obtenha pelo GPS" 
                                class="w-full px-4 py-3.5 rounded-2xl border border-slate-300 focus:border-brand-cyan focus:ring-2 focus:ring-sky-500/20 focus:outline-none text-sm transition">
                            
                            <div class="flex flex-wrap gap-2">
                                <button type="button" id="btn-get-gps" onclick="captureGPSLocation()" 
                                    class="flex-1 py-3 px-4 rounded-xl bg-brand-surface hover:bg-sky-100/70 text-brand-900 font-bold text-xs sm:text-sm transition flex items-center justify-center gap-2 border border-sky-200">
                                    <i class="fa-solid fa-location-crosshairs text-brand-cyan"></i>
                                    <span>Obter localização actual</span>
                                </button>
                                <a id="btn-open-map" href="#" target="_blank" rel="noopener noreferrer" 
