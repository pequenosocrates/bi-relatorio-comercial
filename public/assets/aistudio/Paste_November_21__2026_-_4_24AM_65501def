        // ==================== RENDERIZAÇÃO DO PAINEL PRINCIPAL ====================
        function getVisitStatus(visit) {
            if (visit.isLocked) {
                return { code: 'locked', label: 'Bloqueada', badgeClass: 'bg-emerald-100 text-emerald-800', icon: 'fa-lock' };
            }
            const hasAnyData = Boolean(
                visit.company.trim() || 
                visit.description.trim() || 
                visit.location.trim() || 
                visit.problem.trim() || 
                visit.feedback.trim() || 
                visit.probability || 
                visit.nextAction
            );
            if (hasAnyData) {
                return { code: 'in_progress', label: 'Em curso', badgeClass: 'bg-amber-100 text-amber-800', icon: 'fa-pen' };
            }
            return { code: 'empty', label: 'Por preencher', badgeClass: 'bg-slate-100 text-slate-600', icon: 'fa-regular fa-circle' };
        }

