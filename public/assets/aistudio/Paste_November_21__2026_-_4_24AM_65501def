                                class="w-36 text-center uppercase font-bold tracking-widest px-4 py-3.5 rounded-2xl border border-slate-300 focus:border-brand-cyan focus:outline-none text-base text-brand-900">
                            <button onclick="updateConfiguredCode()" class="flex-1 px-4 py-3.5 rounded-2xl bg-brand-900 hover:bg-brand-800 text-white font-bold text-sm transition">
