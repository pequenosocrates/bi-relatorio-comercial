        function selectProbability(value) {
            const visit = appState.visits[appState.currentVisitIndex];
            if (visit.isLocked) return;
            visit.probability = value;
            visit.updatedAt = new Date().toISOString();
            saveDailyReport();
            updateProbabilityUI(value, false);
        }

        function updateProbabilityUI(selectedValue, isLocked) {
            document.querySelectorAll('.prob-btn').forEach(btn => {
                const opt = PROBABILITY_OPTIONS.find(o => o.id === btn.dataset.value);
                btn.disabled = isLocked;
                if (btn.dataset.value === selectedValue) {
                    btn.className = `prob-btn py-3 px-2 rounded-xl border text-xs font-bold transition text-center shadow-sm ${opt.active}`;
                } else {
                    btn.className = `prob-btn py-3 px-2 rounded-xl border text-xs font-bold transition text-center ${opt.color} ${isLocked ? 'opacity-60' : ''}`;
                }
            });
