    <!-- ==================== LÓGICA DA APLICAÇÃO (JAVASCRIPT) ==================== -->
    <script>
        /**
         * ARQUITECTURA DE DADOS E ESTADO
         * Preparada para futura sincronização com backend e múltiplos utilizadores.
         */
        const STORAGE_KEYS = {
            AUTH_SESSION: 'rcd_session_authenticated',
            CONFIG_CODE: 'rcd_configured_access_code',
            SELLER_NAME: 'rcd_seller_name',
            REPORTS_PREFIX: 'rcd_report_' // Seguido de YYYY-MM-DD
        };

        const PROBABILITY_OPTIONS = [
            { id: 'Muito baixa', label: 'Muito baixa', color: 'border-red-200 text-red-700 bg-red-50/50', active: 'bg-red-600 text-white border-red-600' },
            { id: 'Baixa', label: 'Baixa', color: 'border-orange-200 text-orange-700 bg-orange-50/50', active: 'bg-orange-500 text-white border-orange-500' },
            { id: 'Neutra', label: 'Neutra', color: 'border-slate-200 text-slate-700 bg-slate-50', active: 'bg-slate-700 text-white border-slate-700' },
            { id: 'Maior', label: 'Maior', color: 'border-blue-200 text-blue-700 bg-blue-50/50', active: 'bg-blue-600 text-white border-blue-600' },
            { id: 'Muito maior', label: 'Muito maior', color: 'border-emerald-200 text-emerald-700 bg-emerald-50/50', active: 'bg-emerald-600 text-white border-emerald-600' }
        ];

        const ACTION_OPTIONS = [
            'Ligação',
            'Nova visita',
            'Apresentar proposta',
            'Encerramento',
            'Outro'
        ];

        // Estado em memória
        let appState = {
            currentDateISO: getTodayISO(),
            activeDateISO: getTodayISO(),
            currentVisitIndex: 0, // 0 a 9 (corresponde a Visita 01 a 10)
            currentView: 'dashboard',
            visits: []
        };

        // ==================== UTILITÁRIOS DE DATA ====================
        function getTodayISO() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function formatDatePT(isoDate) {
            if (!isoDate) return '';
            const [y, m, d] = isoDate.split('-');
            return `${d}/${m}/${y}`;
        }

        // ==================== INICIALIZAÇÃO ====================
        window.addEventListener('DOMContentLoaded', () => {
            // Verificar sessão activa
            const isAuthenticated = sessionStorage.getItem(STORAGE_KEYS.AUTH_SESSION) === 'true';
            if (isAuthenticated && localStorage.getItem(STORAGE_KEYS.CONFIG_CODE)) {
                showMainApp();
            } else {
                showAuthScreen();
            }

            // Listeners do ecrã de autenticação e criação de palavra-passe
            setupAuthListeners();

            // Listeners de autosave nos campos do formulário
            setupFormAutosave();

            // Protecção contra saída acidental ou botão Back do telemóvel
            window.addEventListener('popstate', (e) => {
                if (sessionStorage.getItem(STORAGE_KEYS.AUTH_SESSION) === 'true') {
                    // Mantém o utilizador dentro da plataforma e regressa ao painel se estiver numa subvista
                    if (appState.currentView !== 'dashboard') {
                        history.pushState({ view: 'dashboard' }, '');
                        navigateTo('dashboard', false);
                    }
                }
            });
        });

        // ==================== SISTEMA DE AUTENTICAÇÃO E CRIAÇÃO DE PALAVRA-PASSE ====================
        function setupAuthListeners() {
            const loginForm = document.getElementById('login-form');
            const input = document.getElementById('access-code-input');
            const toggleBtn = document.getElementById('toggle-code-visibility');
            const errorMsg = document.getElementById('auth-error-msg');

            const setupForm = document.getElementById('setup-code-form');
            const newCodeInput = document.getElementById('new-code-input');
            const confirmCodeInput = document.getElementById('confirm-code-input');
            const setupErrorMsg = document.getElementById('setup-error-msg');

            const sanitizeCodeInput = (el, errEl) => {
                el.addEventListener('input', () => {
                    el.value = el.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                    errEl.classList.add('hidden');
                });
            };

            sanitizeCodeInput(input, errorMsg);
            sanitizeCodeInput(newCodeInput, setupErrorMsg);
            sanitizeCodeInput(confirmCodeInput, setupErrorMsg);

            // Mostrar/Ocultar código no login
            toggleBtn.addEventListener('click', () => {
                const isPass = input.type === 'password';
                input.type = isPass ? 'text' : 'password';
                toggleBtn.innerHTML = isPass ? '<i class="fa-regular fa-eye-slash"></i>' : '<i class="fa-regular fa-eye"></i>';
            });

            // Criação inicial de palavra-passe
            setupForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const newCode = newCodeInput.value.trim().toUpperCase();
                const confirmCode = confirmCodeInput.value.trim().toUpperCase();
                const formatRegex = /^[A-Z]{2}[0-9]{3}$/;

                if (!formatRegex.test(newCode)) {
                    setupErrorMsg.querySelector('span').textContent = 'Formato inválido. Utilize exactamente 2 letras maiúsculas e 3 números (ex: AB123).';
                    setupErrorMsg.classList.remove('hidden');
                    return;
                }

                if (newCode !== confirmCode) {
                    setupErrorMsg.querySelector('span').textContent = 'As palavras-passe introduzidas não coincidem.';
                    setupErrorMsg.classList.remove('hidden');
                    return;
                }

                // Guardar palavra-passe criada e limpar campos
                localStorage.setItem(STORAGE_KEYS.CONFIG_CODE, newCode);
                newCodeInput.value = '';
                confirmCodeInput.value = '';
                sessionStorage.setItem(STORAGE_KEYS.AUTH_SESSION, 'true');
                history.pushState({ view: 'dashboard' }, '');
                showMainApp();
                showToast('Palavra-passe criada e guardada com sucesso!', 'success');
            });

            // Submissão do código no login
            loginForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const code = input.value.trim().toUpperCase();
                
                // Validar formato: exactamente 2 letras maiúsculas seguidas de 3 números (ex: AB123)
                const formatRegex = /^[A-Z]{2}[0-9]{3}$/;
                const configuredCode = localStorage.getItem(STORAGE_KEYS.CONFIG_CODE);

                if (!formatRegex.test(code)) {
                    errorMsg.querySelector('span').textContent = 'Formato inválido. Utilize 2 letras maiúsculas e 3 números (ex: AB123).';
                    errorMsg.classList.remove('hidden');
                    return;
                }

                if (code !== configuredCode) {
                    errorMsg.querySelector('span').textContent = 'Palavra-passe incorrecta. Tente novamente.';
                    errorMsg.classList.remove('hidden');
                    return;
                }

                // Sucesso: limpar campo para não expor o código na interface
                input.value = '';
                input.type = 'password';
                sessionStorage.setItem(STORAGE_KEYS.AUTH_SESSION, 'true');
                history.pushState({ view: 'dashboard' }, '');
                showMainApp();
            });
        }

        function showAuthScreen() {
            document.getElementById('auth-screen').classList.remove('hidden');
            document.getElementById('app-shell').classList.add('hidden');

            const hasConfiguredCode = Boolean(localStorage.getItem(STORAGE_KEYS.CONFIG_CODE));
            const loginForm = document.getElementById('login-form');
            const setupForm = document.getElementById('setup-code-form');
            const subtitle = document.getElementById('auth-subtitle');

            if (hasConfiguredCode) {
                loginForm.classList.remove('hidden');
                setupForm.classList.add('hidden');
                subtitle.textContent = 'Plataforma móvel de registo comercial no terreno. Introduza a sua palavra-passe de acesso.';
            } else {
                loginForm.classList.add('hidden');
                setupForm.classList.remove('hidden');
                subtitle.textContent = 'Configure a sua palavra-passe pessoal para proteger os seus relatórios comerciais.';
            }
        }

        function showMainApp() {
            document.getElementById('auth-screen').classList.add('hidden');
            document.getElementById('app-shell').classList.remove('hidden');
            document.getElementById('app-shell').classList.add('flex');

            loadDailyReport(appState.currentDateISO);
            renderOptionButtons();
            navigateTo('dashboard', false);
        }

        function handleLogout() {
            openModal({
                title: 'Terminar Sessão',
                message: 'Os seus dados estão guardados com segurança no dispositivo. Deseja sair da plataforma?',
                confirmText: 'Sair',
                icon: 'fa-power-off',
                iconBg: 'bg-red-100 text-red-600',
                onConfirm: () => {
                    sessionStorage.removeItem(STORAGE_KEYS.AUTH_SESSION);
                    showAuthScreen();
                }
            });
        }

        // ==================== PERSISTÊNCIA LOCAL POR DATA ====================
        function createEmptyVisitsArray() {
            return Array.from({ length: 10 }, (_, idx) => ({
                id: idx + 1,
                company: '',
                description: '',
                location: '',
                problem: '',
                feedback: '',
                probability: '',
                nextAction: '',
                otherAction: '',
                isLocked: false,
                updatedAt: null
            }));
        }

        function loadDailyReport(dateISO) {
            appState.activeDateISO = dateISO;
            const storageKey = STORAGE_KEYS.REPORTS_PREFIX + dateISO;
            const raw = localStorage.getItem(storageKey);

            if (raw) {
                try {
                    const parsed = JSON.parse(raw);
                    if (Array.isArray(parsed.visits) && parsed.visits.length === 10) {
                        appState.visits = parsed.visits;
                    } else {
                        appState.visits = createEmptyVisitsArray();
                    }
                } catch (err) {
                    appState.visits = createEmptyVisitsArray();
                }
            } else {
                appState.visits = createEmptyVisitsArray();
                saveDailyReport();
            }

            document.getElementById('header-date-display').textContent = formatDatePT(dateISO);
        }

        function saveDailyReport() {
            const storageKey = STORAGE_KEYS.REPORTS_PREFIX + appState.activeDateISO;
            const payload = {
                date: appState.activeDateISO,
                sellerName: localStorage.getItem(STORAGE_KEYS.SELLER_NAME) || '',
                lastUpdated: new Date().toISOString(),
                visits: appState.visits
            };
            localStorage.setItem(storageKey, JSON.stringify(payload));
        }

        // ==================== NAVEGAÇÃO ENTRE VISTAS ====================
        function navigateTo(viewName, pushHistory = true) {
            appState.currentView = viewName;

            if (pushHistory) {
                history.pushState({ view: viewName }, '');
            }

            // Ocultar todas as secções
            ['dashboard', 'visit', 'summary', 'settings'].forEach(v => {
                document.getElementById(`view-${v}`).classList.add('hidden');
            });

            // Mostrar secção alvo
            document.getElementById(`view-${viewName}`).classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });

            if (viewName === 'dashboard') {
                renderDashboard();
            } else if (viewName === 'visit') {
                renderVisitForm(appState.currentVisitIndex);
            } else if (viewName === 'summary') {
                renderSummary();
            } else if (viewName === 'settings') {
                renderSettings();
            }
        }

        function openVisit(index) {
            if (index < 0 || index > 9) return;
            appState.currentVisitIndex = index;
