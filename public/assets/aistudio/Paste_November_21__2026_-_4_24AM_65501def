        function setupFormAutosave() {
            const textFields = [
                { id: 'field-company', key: 'company' },
                { id: 'field-description', key: 'description' },
                { id: 'field-location', key: 'location' },
                { id: 'field-problem', key: 'problem' },
                { id: 'field-feedback', key: 'feedback' },
                { id: 'field-other-action', key: 'otherAction' }
            ];

            textFields.forEach(item => {
                const el = document.getElementById(item.id);
                el.addEventListener('input', () => {
                    const visit = appState.visits[appState.currentVisitIndex];
                    if (visit.isLocked) return; // Protecção extra contra edição se bloqueado
                    visit[item.key] = el.value;
                    visit.updatedAt = new Date().toISOString();
                    saveDailyReport();

                    if (item.key === 'location') {
                        updateMapLinkButton(el.value);
                    }
                });
