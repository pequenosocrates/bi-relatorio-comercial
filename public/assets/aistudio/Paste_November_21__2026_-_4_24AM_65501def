        function prepareWhatsAppShare() {
            const recorded = getRecordedVisits();
            if (recorded.length === 0) {
                showToast('Registe pelo menos uma visita antes de enviar o relatório.', 'error');
                return;
            }

            const reportText = generateWhatsAppReportText();

            openModal({
                title: 'Enviar pelo WhatsApp',
                message: 'O relatório está pronto para envio. Deseja continuar?',
                confirmText: 'Abrir WhatsApp',
                icon: 'fa-whatsapp',
                iconBg: 'bg-emerald-100 text-emerald-600',
                onConfirm: () => {
                    // Abrir WhatsApp com o texto pré-preenchido (o utilizador escolhe o contacto/grupo)
                    const encodedText = encodeURIComponent(reportText);
                    const waUrl = `https://api.whatsapp.com/send?text=${encodedText}`;
                    window.open(waUrl, '_blank', 'noopener,noreferrer');
                }
            });
        }

        // ==================== EXPORTAÇÃO EXCEL (.XLSX) E PARTILHA NATIVA ====================
        function exportToExcel(shareAfterExport = false) {
            const recorded = getRecordedVisits();
            if (recorded.length === 0) {
                showToast('Não existem visitas registadas para exportar.', 'error');
                return;
            }

            if (typeof XLSX === 'undefined') {
                showToast('A biblioteca Excel ainda está a carregar. Tente novamente em instantes.', 'error');
                return;
            }

            // Construir linhas estritamente com as 4 colunas solicitadas
            const rows = recorded.map(visit => {
                const actionText = visit.nextAction === 'Outro' 
                    ? `Outro: ${visit.otherAction || 'Não especificado'}` 
                    : (visit.nextAction || '');

                return {
                    'Empresa': visit.company.trim(),
                    'Descrição': visit.description.trim(),
                    'Problema': visit.problem.trim(),
                    'Acção a seguir': actionText
                };
            });

            // Criar folha de cálculo
            const worksheet = XLSX.utils.json_to_sheet(rows, {
                header: ['Empresa', 'Descrição', 'Problema', 'Acção a seguir']
            });

            // Ajustar largura das colunas para boa legibilidade
            worksheet['!cols'] = [
                { wch: 28 }, // Empresa
                { wch: 42 }, // Descrição
                { wch: 42 }, // Problema
                { wch: 26 }  // Acção a seguir
            ];

            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, 'Relatório Comercial');

            const fileName = `Relatorio_Comercial_${appState.activeDateISO}.xlsx`;

            if (shareAfterExport) {
                // Gerar Blob / File para Web Share API nativa (Android/iOS)
                const wbout = XLSX.write(workbook, { bookType: 'xlsx', type: 'array' });
                const blob = new Blob([wbout], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                const file = new File([blob], fileName, { type: blob.type });

                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                    navigator.share({
                        title: 'Relatório Comercial Diário',
                        text: `Relatório Comercial Diário (${formatDatePT(appState.activeDateISO)})`,
                        files: [file]
                    }).then(() => {
                        showToast('Ficheiro Excel partilhado com sucesso!', 'success');
                    }).catch((err) => {
                        if (err.name !== 'AbortError') {
                            // Fallback para download directo
                            XLSX.writeFile(workbook, fileName);
                            showToast('Ficheiro Excel descarregado para o dispositivo.', 'info');
                        }
                    });
                } else {
                    // Fallback se o navegador não suportar partilha de ficheiros
                    XLSX.writeFile(workbook, fileName);
                    showToast('Ficheiro Excel descarregado! Pode anexá-lo no WhatsApp.', 'info');
                }
            } else {
                // Download directo
                XLSX.writeFile(workbook, fileName);
                showToast(`Ficheiro ${fileName} descarregado!`, 'success');
            }
        }

        // ==================== DEFINIÇÕES, HISTÓRICO E REINÍCIO ====================
        function updateSellerUI() {
            const name = localStorage.getItem(STORAGE_KEYS.SELLER_NAME) || '';
            document.getElementById('dash-seller-name').textContent = name || 'Não definido (Toque em Editar)';
        }

        function renderSettings() {
            document.getElementById('settings-seller-name').value = localStorage.getItem(STORAGE_KEYS.SELLER_NAME) || '';
            document.getElementById('settings-access-code').value = localStorage.getItem(STORAGE_KEYS.CONFIG_CODE) || '';

            // Listar datas guardadas no localStorage
            const historyContainer = document.getElementById('history-dates-list');
            historyContainer.innerHTML = '';

            const dates = [];
            for (let i = 0; i < localStorage.length; i++) {
                const key = localStorage.key(i);
                if (key && key.startsWith(STORAGE_KEYS.REPORTS_PREFIX)) {
                    dates.push(key.replace(STORAGE_KEYS.REPORTS_PREFIX, ''));
                }
            }
            dates.sort().reverse();

            dates.forEach(dateISO => {
                const isSelected = dateISO === appState.activeDateISO;
                const item = document.createElement('div');
                item.className = `flex items-center justify-between p-3 rounded-2xl border ${isSelected ? 'bg-blue-50 border-blue-200' : 'bg-slate-50 border-slate-200'}`;
                item.innerHTML = `
                    <div>
                        <span class="text-sm font-bold text-slate-800">${formatDatePT(dateISO)}</span>
                        ${dateISO === appState.currentDateISO ? '<span class="ml-2 text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-brand-900 text-white">Hoje</span>' : ''}
                    </div>
                    <button onclick="switchReportDate('${dateISO}')" class="px-3 py-1.5 rounded-xl text-xs font-bold ${isSelected ? 'bg-brand-accent text-white' : 'bg-white border border-slate-300 text-slate-700'}">
                        ${isSelected ? 'Activo' : 'Abrir'}
                    </button>
                `;
                historyContainer.appendChild(item);
            });
        }

        function switchReportDate(dateISO) {
            loadDailyReport(dateISO);
            showToast(`Relatório de ${formatDatePT(dateISO)} carregado.`, 'info');
            navigateTo('dashboard');
        }

        function saveSellerName() {
            const name = document.getElementById('settings-seller-name').value.trim();
            if (!name) {
                showToast('Introduza o nome do vendedor.', 'error');
                return;
            }
            localStorage.setItem(STORAGE_KEYS.SELLER_NAME, name);
            saveDailyReport();
            updateSellerUI();
            showToast('Nome do vendedor guardado com sucesso!', 'success');
        }

        function updateConfiguredCode() {
            const newCode = document.getElementById('settings-access-code').value.trim().toUpperCase();
            const formatRegex = /^[A-Z]{2}[0-9]{3}$/;

            if (!formatRegex.test(newCode)) {
                showToast('Formato inválido! Use 2 letras maiúsculas e 3 números (ex: AB123).', 'error');
                return;
            }

            localStorage.setItem(STORAGE_KEYS.CONFIG_CODE, newCode);
            showToast('Código de acesso actualizado com sucesso!', 'success');
        }

        function confirmResetDailyReport() {
            openModal({
                title: 'Reiniciar Relatório de Hoje',
                message: `Tem a certeza absoluta de que pretende apagar todas as visitas registadas no dia ${formatDatePT(appState.activeDateISO)}? Esta acção não pode ser desfeita.`,
                confirmText: 'Sim, apagar tudo',
                icon: 'fa-triangle-exclamation',
                iconBg: 'bg-red-100 text-red-600',
                onConfirm: () => {
                    appState.visits = createEmptyVisitsArray();
                    appState.currentVisitIndex = 0;
                    saveDailyReport();
                    showToast('Relatório reiniciado com sucesso.', 'info');
                    navigateTo('dashboard');
                }
            });
        }

        // ==================== COMPONENTES DE INTERFACE (MODAL E TOAST) ====================
        function openModal({ title, message, confirmText = 'Confirmar', icon = 'fa-circle-info', iconBg = 'bg-blue-100 text-blue-600', onConfirm }) {
            const modal = document.getElementById('custom-modal');
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-message').textContent = message;
            
            const iconContainer = document.getElementById('modal-icon-container');
            iconContainer.className = `w-10 h-10 rounded-full flex items-center justify-center shrink-0 ${iconBg}`;
            document.getElementById('modal-icon').className = `fa-solid ${icon} text-lg`;

            const confirmBtn = document.getElementById('modal-confirm-btn');
            const cancelBtn = document.getElementById('modal-cancel-btn');
            confirmBtn.textContent = confirmText;

            const closeModal = () => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            };

            cancelBtn.onclick = closeModal;
            confirmBtn.onclick = () => {
                closeModal();
                if (typeof onConfirm === 'function') onConfirm();
            };

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const styles = {
                success: 'bg-emerald-900 text-white border-emerald-700',
                error: 'bg-red-900 text-white border-red-700',
                info: 'bg-brand-900 text-white border-brand-cyan'
            };

            const icons = {
                success: 'fa-circle-check text-emerald-400',
                error: 'fa-circle-exclamation text-red-400',
                info: 'fa-circle-info text-brand-gold'
            };

            toast.className = `px-4 py-3 rounded-2xl shadow-xl border text-xs sm:text-sm font-semibold flex items-center gap-2.5 transition-all duration-300 transform translate-y-2 opacity-0 ${styles[type] || styles.info}`;
            toast.innerHTML = `<i class="fa-solid ${icons[type] || icons.info} text-base shrink-0"></i><span>${escapeHTML(message)}</span>`;

            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }

        function escapeHTML(str) {
            if (!str) return '';
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[tag] || tag));
        }
    </script>
</body>
