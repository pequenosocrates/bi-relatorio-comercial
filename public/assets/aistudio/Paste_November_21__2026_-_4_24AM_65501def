        // ==================== GEOLOCALIZAÇÃO GPS ====================
        function captureGPSLocation() {
            const visit = appState.visits[appState.currentVisitIndex];
            if (visit.isLocked) return;

            if (!navigator.geolocation) {
                showToast('O seu dispositivo não suporta geolocalização GPS.', 'error');
                return;
            }

            const btn = document.getElementById('btn-get-gps');
            const originalHTML = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-brand-accent"></i><span>A obter coordenadas GPS...</span>';

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const lat = position.coords.latitude.toFixed(6);
                    const lng = position.coords.longitude.toFixed(6);
                    const mapsUrl = `https://www.google.com/maps?q=${lat},${lng}`;
                    
                    const locInput = document.getElementById('field-location');
                    locInput.value = mapsUrl;
                    visit.location = mapsUrl;
                    visit.updatedAt = new Date().toISOString();
                    saveDailyReport();
                    updateMapLinkButton(mapsUrl);

                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                    showToast('Localização GPS registada com sucesso!', 'success');
                },
                (error) => {
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                    let msg = 'Não foi possível obter a localização.';
                    if (error.code === error.PERMISSION_DENIED) {
                        msg = 'Permissão de localização negada. Active o GPS no telemóvel.';
                    }
                    showToast(msg, 'error');
                },
                { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 }
            );
        }

        function updateMapLinkButton(url) {
            const mapBtn = document.getElementById('btn-open-map');
            if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
                mapBtn.href = url;
                mapBtn.classList.remove('hidden');
                mapBtn.classList.add('inline-flex');
            } else {
                mapBtn.classList.add('hidden');
                mapBtn.classList.remove('inline-flex');
            }
        }

        // ==================== MECANISMO DE TRANCAR / DESTRANCAR ====================
        function validateVisitRequiredFields(visit) {
            if (!visit.company.trim()) {
                return 'Por favor, preencha o nome da Empresa (Campo 01).';
            }
            if (!visit.description.trim()) {
                return 'Por favor, preencha a Descrição da visita (Campo 02).';
            }
            if (!visit.problem.trim()) {
                return 'Por favor, registe o Problema identificado (Campo 04).';
            }
            if (!visit.nextAction) {
                return 'Por favor, seleccione a Acção a seguir (Campo 07).';
            }
            if (visit.nextAction === 'Outro' && !visit.otherAction.trim()) {
                return 'Por favor, especifique qual é a outra acção a seguir.';
            }
            return null;
        }

        function lockCurrentOnly() {
            const visit = appState.visits[appState.currentVisitIndex];
            const validationError = validateVisitRequiredFields(visit);

            if (validationError) {
                showToast(validationError, 'error');
                return;
            }

            visit.isLocked = true;
            visit.updatedAt = new Date().toISOString();
            saveDailyReport();
            renderVisitForm(appState.currentVisitIndex);
            showToast(`Visita ${String(visit.id).padStart(2, '0')} trancada e protegida!`, 'success');
        }

        function lockAndAdvance() {
            const visit = appState.visits[appState.currentVisitIndex];
            const validationError = validateVisitRequiredFields(visit);

            if (validationError) {
                showToast(validationError, 'error');
                return;
            }

            visit.isLocked = true;
            visit.updatedAt = new Date().toISOString();
            saveDailyReport();
            showToast(`Visita ${String(visit.id).padStart(2, '0')} concluída e protegida!`, 'success');

            if (appState.currentVisitIndex < 9) {
                openVisit(appState.currentVisitIndex + 1);
